<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; script-src 'sha256-@@SCRIPT_HASH@@'; style-src 'sha256-@@STYLE_HASH@@'; base-uri 'none'; form-action 'none'">
<title>電子たばこと喘息 ｜ ライフステージで読む</title>
<style>
:root { --ink:#202e39; --paper:#faf8f1; --rule:#d9d9cd; --accent:#186e68; --wash:#e9f3e9; --deep:#255e58; color:var(--ink); background:var(--paper); font:16px/1.55 -apple-system,BlinkMacSystemFont,"Hiragino Sans","Yu Gothic",sans-serif }
* { box-sizing:border-box }
body { margin:0 }
button,input,select { font:inherit; color:inherit }
button,a,summary { touch-action:manipulation }
button { cursor:pointer }
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible { outline:3px solid #246dba; outline-offset:3px }
button:disabled { opacity:.35; cursor:default }
header { background:#213337; color:#fff }
.bar,.page { max-width:1250px; margin:auto; padding:0 clamp(16px,4.3vw,60px) }
.bar { height:54px; display:flex; align-items:center; gap:13px }
.brand { font-size:.88rem; font-weight:750; letter-spacing:.08em }
.pmid,.journal,.serial,.figure-label,.study-line,.micro { font-family:"Avenir Next",Avenir,-apple-system,sans-serif }
.pmid { color:#c7dbd1; font-size:.76rem; border-left:1px solid #6c7976; padding-left:14px }
.library-button { margin-left:auto; background:transparent; border:1px solid #839690; border-radius:20px; color:inherit; padding:4px 13px; font-size:.8rem }
h1,h2,h3,p,figure { margin:0 }
h1,h2,h3 { line-height:1.32; text-wrap:pretty }
.intro { display:flex; justify-content:space-between; align-items:end; gap:20px; padding:23px 0 18px }
.intro h1 { font-size:clamp(1.85rem,3.2vw,2.9rem); letter-spacing:-.055em }
.intro h1 span { color:#517068; font-size:.47em; letter-spacing:.025em; display:inline-block; margin-left:14px }
.journal { font-size:.77rem; color:#546763; margin-top:5px }
.serial { font-family:Georgia,serif; font-style:italic; color:#596962 }
.stages { position:relative; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:7px; border-block:1px solid var(--rule); padding:7px 0 }
.stage { position:relative; isolation:isolate; display:flex; align-items:center; justify-content:center; gap:8px; background:transparent; border:0; border-radius:13px; font-weight:750; padding:0 5px; height:86px }
.stage svg { height:80px; width:82px; overflow:visible }
.stage small { display:block; font-size:.71rem; font-weight:500; color:#576362 }
.stage[aria-pressed=true] { background:var(--wash); box-shadow:inset 0 -3px var(--accent); color:var(--deep) }
.stage:hover { background:#eeeae0 }
.stage:not(:last-child):after { content:""; position:absolute; right:-14px; top:50%; width:24px; border-top:3px dotted #b9bdb1; z-index:-1 }
.stage b { display:block; font-size:1.05rem }
.board { display:grid; grid-template-columns:minmax(0,1.09fr) minmax(0,1fr); border:1px solid #cecec0; border-radius:22px; overflow:hidden; background:#fffefa; margin:16px 0 12px; box-shadow:0 5px 0 #26372d08 }
.scene { position:relative; display:flex; flex-direction:column; justify-content:space-between; background:var(--wash); padding:22px clamp(18px,2vw,30px) 15px; min-width:0 }
.figure-label { display:flex; align-items:center; gap:8px; color:var(--deep); font-weight:750; letter-spacing:.08em; font-size:.77rem }
.figure-label:before { content:""; width:25px; height:2px; background:var(--deep) }
.scene h2 { font-size:clamp(1.45rem,2.2vw,2.05rem); letter-spacing:-.04em; margin-top:8px }
.art { display:block; width:100%; height:auto; max-height:310px }
.art .ink { stroke:#293a3c; stroke-linecap:round; stroke-linejoin:round; stroke-width:2.7 }
.art text { font-family:-apple-system,BlinkMacSystemFont,"Hiragino Sans",sans-serif; fill:#273934; font-weight:650 }
.art .label { font-size:15px; paint-order:stroke; stroke:var(--wash); stroke-width:5px; stroke-linejoin:round }
.art .leader { fill:none; stroke:#526d60; stroke-width:1.6; stroke-dasharray:4 4 }
.inkline { fill:none; stroke:#283e3c; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round }
.scenebottom { display:flex; align-items:center; justify-content:space-between; gap:8px; border-top:1px solid #26382e25; padding-top:9px; color:#435b54; font-size:.81rem }
.arrows { display:flex; gap:5px }
.round { border:1px solid #849b89; border-radius:50%; height:33px; width:33px; background:#ffffff75; font-size:1.05rem }
.panel { padding:22px clamp(18px,2vw,32px); display:flex; flex-direction:column; gap:12px; min-width:0 }
.switches { display:flex; gap:3px; background:#efefe7; padding:3px; border-radius:11px; align-self:start; max-width:100%; flex-wrap:wrap }
.switches button { font-size:.81rem; font-weight:650; border:0; border-radius:8px; padding:6px 12px; background:transparent }
.switches button[aria-pressed=true] { background:#fff; box-shadow:0 1px 4px #22352a24; color:var(--deep) }
.study-line { font-size:.8rem; color:#48615b; font-weight:650 }
.panel h3 { font-size:clamp(1.3rem,1.85vw,1.7rem); letter-spacing:-.045em }
.panel .population { font-size:.83rem; color:#475651 }
.result { background:#f6f6ee; border-radius:12px; padding:11px 15px }
.number { font-size:2.45rem; font-family:Georgia,serif; line-height:.99; font-weight:bold; letter-spacing:-.045em; color:var(--deep) }
.metric { font-weight:700; font-size:.88rem; margin-right:7px }
.ci { display:inline-block; font-size:.85rem; margin-left:8px }
.outcome { font-size:.78rem; margin-bottom:6px }
.plot { display:block; width:100%; height:auto; max-height:150px }
.plot text { font-family:-apple-system,sans-serif; fill:#33443e }
.plot-row { cursor:pointer }
.plot-row:hover .halo,.plot-row:focus .halo { opacity:.28 }
.plot-row:focus { outline:none }
.micro { font-size:.71rem; color:#52635b }
.actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:auto }
.pill,.ref,.step { border:1px solid #abbbb0; background:transparent; border-radius:22px; padding:6px 13px; font-size:.82rem; font-weight:650 }
.pill,.step { background:var(--deep); border-color:var(--deep); color:white }
.ref { border-color:transparent; text-decoration:underline; text-underline-offset:.22em }
.steps { display:flex; gap:8px; align-items:center }
.step { padding:6px 12px }
.state-note { font-size:.84rem }
.legend { display:flex; justify-content:space-between; gap:12px; align-items:center; padding:0 2px 20px; color:#56635d; font-size:.74rem }
.legend button { font-size:.76rem }
.art-button { display:grid; justify-items:center; width:100%; padding:0 0 6px; background:none; border:0; border-radius:10px }
#artAction { font-size:.72rem; color:var(--deep); border-bottom:1px dotted currentColor }
.acute { display:grid; grid-template-columns:repeat(3,1fr); gap:4px; margin:6px 0 }
.vital { border:1px solid #babfb6; border-radius:9px; padding:7px 2px; background:#e5efea; font-size:.85rem; font-weight:700; color:#214d48 }
.vital:last-child { background:#f6e8d7; color:#714923 }
.vital span { display:block; font-size:1.65rem; line-height:1.05 }
dialog { border:1px solid var(--rule); border-radius:18px; background:#fffdf7; color:var(--ink); padding:0; width:min(760px,calc(100% - 24px)); max-height:88dvh; box-shadow:0 16px 70px #152e3c42 }
dialog::backdrop { background:#182f32a6 }
.dialogbar { position:sticky; top:0; background:#fffdf7; display:flex; align-items:center; justify-content:space-between; gap:8px; border-bottom:1px solid var(--rule); padding:14px 22px; z-index:2 }
.dialogbar h2 { font-size:1.22rem }
.inside { padding:16px 22px 26px }
.inside p,.inside li { margin:.3em 0 }
.inside details { border-bottom:1px solid var(--rule); padding:.65rem 0 }
.inside summary { cursor:pointer; font-weight:650 }
.inside h3 { font-size:1rem; color:#24675c; margin:1rem 0 .3rem }
.inside a { color:#11635b }
.inside blockquote { margin:.5em 0; background:#eff3ed; padding:10px 13px; overflow-wrap:anywhere; white-space:pre-wrap }
.inside dt { color:#4d6259; font-size:.78rem }
.inside dd { margin:0 0 .6rem }
.inside input { width:100%; padding:9px; border-radius:8px; border:1px solid #9caf9e }
.inside pre { white-space:pre-wrap; overflow-wrap:anywhere }
.keys { display:flex; gap:6px; flex-wrap:wrap; margin:10px 0 }
.keys button { background:white; border:1px solid var(--rule); border-radius:16px; padding:5px 12px }
.keys button[aria-pressed=true] { background:#263f3a; color:white }
.scene svg .drift { animation:drift 6s ease-in-out infinite }
.scene svg .reveal { animation:reveal .3s ease-out }
@keyframes drift {
    50% { transform:translate(3px,-3px) }
}
@keyframes reveal {
    from { opacity:.2 }
    to { opacity:1 }
}
@media(prefers-reduced-motion:reduce) {
    *,*::before,*::after { animation:none!important; transition:none!important }
}
@media(max-width:800px) {
    .bar,.page { padding-inline:16px }
    .stage { height:75px }
    .stage svg { width:60px; height:65px }
    .stage small { display:none }
    .panel,.scene { padding:16px }
    .switches button { padding:6px 9px }
    .art { max-height:290px }
    .board { grid-template-columns:minmax(0,1fr) minmax(0,1fr) }
}
@media(max-width:650px) {
    .intro { padding:16px 0 11px }
    .intro h1 span { display:block; margin:4px 0 0; font-size:.51em }
    .serial { display:none }
    .pmid { font-size:.68rem; padding-left:8px }
    .bar { gap:7px; height:45px }
    .brand { font-size:.76rem }
    .library-button { padding:4px 9px; font-size:.73rem }
    .journal { font-size:.66rem }
    .stages { gap:1px; padding:4px 0 }
    .stage { height:67px; flex-direction:column; gap:0 }
    .stage svg { width:46px; height:42px }
    .stage b { font-size:.8rem }
    .stage:not(:last-child):after { width:12px; right:-7px; top:40% }
    .board { display:block; margin-top:10px; border-radius:15px }
    .scene { padding:12px 14px 8px }
    .scene h2 { font-size:1.32rem; margin-top:2px }
    .figure-label { font-size:.66rem }
    .art { max-height:178px }
    .scenebottom { font-size:.73rem; padding-top:4px }
    .panel { padding:13px 15px; gap:8px }
    .panel h3 { font-size:1.28rem }
    .legend { flex-wrap:wrap; gap:4px }
    .inside,.dialogbar { padding-inline:14px }
    .number { font-size:2rem }
    .switches button { min-height:34px }
    .round { height:32px; width:32px }
}
.symbols { position:absolute; width:0; height:0; overflow:hidden; pointer-events:none }
body[data-stage="0"] { --wash:#f0e8ef; --deep:#6e4e72; --accent:#936f98 }
body[data-stage="1"] { --wash:#fcf0d9; --deep:#76552b; --accent:#b58245 }
body[data-stage="3"] { --wash:#e8eff2; --deep:#355b70; --accent:#62849b }
</style></head><body>
<header><div class="bar"><svg width="25" height="27" viewBox="0 0 28 28" fill="none" stroke="#dcead8" stroke-width="2"><path d="M13 3v9l-5 4m7-13v9l5 4M10 8C6 6 1 17 3 23c2 3 7-1 9-4V9m5-1c4-2 9 9 8 14-2 3-7 0-9-3V9"/></svg><b class="brand">論文グラレコ</b><span class="pmid">PMID 42526604</span><button class="library-button" id="library">全研究・原文 ↗</button></div></header>
<main class="page"><div class="intro"><div><h1>電子たばこと喘息<span>ライフステージで読む</span></h1><p class="journal">Pereira et al.　·　J Allergy Clin Immunol　·　2026</p></div><span class="serial">Use of electronic cigarettes and asthma across the lifespan</span></div>
<nav class="stages" id="stages" aria-label="ライフステージを選択"></nav>
<div class="board"><section class="scene"><div><p class="figure-label" id="stageLabel"></p><h2 id="sceneTitle"></h2></div>
<button type="button" class="art-button" id="artExplore"><svg id="art" class="art" viewBox="0 0 520 268" role="img"></svg><span id="artAction"></span></button>
<div class="scenebottom"><span id="artCaption"></span><span class="arrows"><button class="round" id="prev" aria-label="前のライフステージ">←</button><button class="round" id="next" aria-label="次のライフステージ">→</button></span></div></section>
<section class="panel" aria-label="選択中の研究"><div class="switches" id="switches" aria-label="テーマを選択"></div><div><p class="study-line" id="studyline"></p><h3 id="message" aria-live="polite"></h3></div><div id="results"></div><p id="population" class="population"></p><div id="actions" class="actions"></div></section></div>
<div class="legend"><span>人物でライフステージを、グラフの点で研究結果を選択できます。</span><button class="ref" id="overview">論文全体の要点・限界</button></div></main>
<dialog id="drawer"><div class="dialogbar"><h2 id="drawerTitle"></h2><button class="round" id="close" aria-label="閉じて図に戻る">×</button></div><div id="drawerBody" class="inside"></div></dialog>

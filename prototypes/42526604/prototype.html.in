<script type="application/json" id="master">@@MASTER@@</script><template id="pdf">@@PDF@@</template>
<script id="app">
'use strict';
const master = JSON.parse(document.getElementById('master').textContent);
const facts = new Map(master.evidence.map(e => [e.id,e]));
const refs = new Map(master.source_references.map(s => [s.id,s]));
const studies = master.teaching.studies;
const $ = id => document.getElementById(id);
const esc = x => String(x ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const use = (id,x,y,scale=1) => '<g transform="translate('+x+' '+y+') scale('+scale+')"><use href="#'+id+'"/></g>';
const labels = ['胎児期','小児期','青年期','成人期'];
const icons = ['fetus','child','teen','adult'];
const topics = ['発育と機序','家庭内曝露','発作と発症','発症と肺機能'];
const options = [['候補機序'],['尿中指標','家庭での曝露'],['喘息発作','呼吸器症状','新規診断'],['発症年齢','急性曝露試験']];
const evidence = [[['e11','e30','e35','e32']],[['e13'],['e14']],[['e15'],['e16','e17','e66'],['e18','e70','e71']],[['e19'],['e20','e98']]];
const messages = [
 ['ヒトの出生前曝露と小児喘息発症を直接調べた研究は、検索時点で見当たらなかった。','ニコチン曝露群の仔で、肺胞の隔壁形成が減少した。','ダニ負荷後の仔で、気道の炎症細胞が変化した。','胎児肺で、曝露条件に応じた遺伝子発現の変化がみられた。'],
 ['尿中コチニンと入院は関連したが、電子たばこ単独曝露は1人だった。','家庭内の受動曝露と症状日数に、有意な差はみられなかった。'],
 ['受動曝露を報告した喘息児では、前年の発作のオッズが高かった。','同じ高校生でも、症状によって関連の見え方が異なる。','単独使用と喘息新規診断の推定値は、不確実性が大きい。'],
 ['成人の現在使用は、より早い喘息発症と関連した。','吸入15分後、喘息群では肺機能が低下し、FeNOは上昇した。']
];
const sceneTitles = [
 ['胎内曝露と、発育中の肺','肺胞の隔壁形成','アレルゲン負荷後の気道','胎児肺の遺伝子発現'],
 ['家庭内で重なる曝露','保護者が報告した家庭内曝露'],
 ['室内・車内の受動曝露','家庭内のエアロゾルと症状','能動使用と、その後の喘息'],
 ['使用歴と喘息の発症年齢','短時間の吸入と肺の応答']
];
let stage = 2, topic = 0, step = 0, selected = 'e15', returnFocus = null, pdfUrl;
const variant = () => stage === 0 ? step : topic;
const ids = () => evidence[stage][topic];
const circle = (x,y,r,fill,extra='') => '<circle cx="'+x+'" cy="'+y+'" r="'+r+'" fill="'+fill+'" '+extra+'/>';
const text = (x,y,s,align='start') => '<text class="label" x="'+x+'" y="'+y+'" text-anchor="'+align+'">'+esc(s)+'</text>';
const line = d => '<path class="leader" d="'+d+'"/>';
function illustration() {
    const ground = '<path d="M20 226q115-10 254 0t223-2" fill="none" stroke="#556e5b" opacity=".4" stroke-width="2"/>';
    const wash = '<path d="M23 198q-13-57 39-93t105-45q77-25 120 4t87 29q73 1 103 50t-18 62q-69 24-220 18t-209-5z" fill="url(#dots)"/>';
    let art = '';
    if (stage === 0) {
        const plate = '<circle cx="350" cy="128" r="87" fill="#fff9ed" stroke="#aa96b1" stroke-width="2.5"/>';
        const marker = '<path d="M160 136q54 8 91-10l12-7" class="leader"/>';
        art = use('fetus',40,53,1.36) + use('mouse',47,181,.62) + text(42,250,'胎内曝露モデル') + marker + plate;
        if (step === 0) art += use('lung',298,69,1.12)+text(350,248,'胎児肺の候補機序','middle');
        if (step === 1) art += use('alveoli',282,64,1.55)+text(350,248,'肺胞発育 · ラット','middle');
        if (step === 2) {
            art += '<ellipse cx="350" cy="128" rx="59" ry="46" fill="#d69594" stroke="#735d6e" stroke-width="2"/><ellipse cx="350" cy="128" rx="44" ry="31" fill="#ffedd4" stroke="#9c6c70" stroke-width="3"/>';
            for (const [x,y] of [[317,91],[374,99],[395,144],[337,162],[303,137]]) {
                art += circle(x,y,8,'#9984ab')+circle(x-2,y,3,'#5d527d')+circle(x+2,y-2,3,'#5d527d');
            }
            art += text(350,248,'炎症細胞 · マウス','middle');
        }
        if (step === 3) {
            art += '<g transform="translate(320 67)" fill="none" stroke-linecap="round"><path d="M0 0c0 26 60 32 60 60S0 99 0 125M60 0C60 26 0 32 0 60s60 39 60 65" stroke="#75669a" stroke-width="6"/><path d="M8 12h44M19 23h22M10 49h40M4 62h52M11 76h38M20 99h20M10 110h40" stroke="#cf9d67" stroke-width="4"/></g>'+text(350,248,'発現変化 · ラット','middle');
        }
    } else if (stage === 1) {
        art = circle(235,130,87,'#f5ce92')+use('house',22,85,1.18)+use('child',146,33,1.67)+
              '<g class="drift">'+use('cloud',81,91,.8)+'</g>'+line('M287 134q40-12 63-11');
        if (topic === 0) {
            art += '<g transform="translate(368 66) rotate(9 20 55)" class="ink"><path d="M2 12h47l-5 81q-1 11-18 11T8 94z" fill="#fbefce"/><path d="M7 55q8 4 18 0t21 0l-3 38q-1 10-17 10T9 92z" fill="#efbd53"/><rect x="-1" y="2" width="52" height="13" rx="4" fill="#83988e"/><path d="M30 28h13m-10 11h9m-11 11h10" fill="none"/></g>'+text(393,199,'尿中指標','middle');
        } else {
            art += '<g transform="translate(350 63)" class="ink"><rect x="0" y="8" width="81" height="103" rx="6" fill="#fff2da"/><rect x="20" y="2" width="40" height="13" rx="4" fill="#c88963"/><path d="m12 38 5 5 9-13m-14 32 5 5 9-13m-14 33 5 5 9-13M33 38h33m-33 25h33m-33 25h33" fill="none"/></g>'+text(392,204,'保護者の申告','middle');
        }
        art += text(29,229,'家庭')+text(227,250,'喘息のある小児','middle');
    } else if (stage === 2) {
        art = circle(261,130,92,'#f2d386')+use('house',19,89,1.14);
        if (topic === 0) art += use('car',66,174,.92);
        art += '<g class="drift">'+use('cloud',99,93,.82)+use('cloud',122,119,.6)+'</g>'+use('teen',171,25,1.72)+line('M306 153q43-16 60-32')+
               circle(407,110,58,'#faf5df','stroke="#859f83" stroke-width="2"')+use('lung',369,68,.78)+text(405,197,topic===2?'新規診断':topic===1?'呼吸器症状':'喘息発作','middle');
        if (topic === 2) art = circle(211,125,92,'#f2d386')+use('teen',116,30,1.67)+line('M258 152q52-17 74-10')+
            '<g transform="translate(338 85)" class="ink"><rect width="88" height="80" fill="#fff7dd" rx="9"/><path d="M0 22h88M19 -6v17m48-17v17" fill="none"/><path d="M16 39h12m9 0h12m9 0h12m-54 16h12m9 0h12" stroke="#84a49c"/><circle cx="67" cy="55" r="8" fill="#dfa053"/></g>'+text(384,198,'追跡期間','middle');
        art += text(245,250,topic===2?'米国PATHの青年':'青年期','middle');
    } else {
        art = circle(171,127,88,'#ccdae6')+use('adult',70,30,1.66)+line('M222 145q53-15 72-9');
        if (topic === 0) {
            art += '<g transform="translate(305 85)" class="ink"><path d="M1 66q46-5 121 0" fill="none"/><path d="M7 58v16m53-16v16m53-16v16" fill="none"/><circle cx="60" cy="39" r="18" fill="#f7d889"/><path d="M60 26v13l8 5" fill="none"/></g>'+text(363,196,'発症年齢を推定','middle');
        } else art += circle(355,119,61,'#fcf0d5','stroke="#8aa3b0" stroke-width="2"')+use('lung',312,74,.87)+text(357,207,'吸入15分後','middle');
        art += text(164,250,topic===0?'成人コホート':'成人喫煙者','middle');
    }
    $('art').innerHTML='<title>'+esc(sceneTitles[stage][variant()])+'</title>'+wash+ground+'<g class="reveal">'+art+'</g>';
}
const titles = ['実験モデル','肺胞発育','気道炎症','遺伝子発現'];
function button(label, action, value, cls='ref') {
    return '<button type="button" class="'+cls+'" data-action="'+action+'" data-value="'+esc(value)+'">'+esc(label)+'</button>';
}
function plot(rows) {
    const points = rows.map(id => {
        const m = facts.get(id).measurements.find(v => v.estimate && v.ci_lower && v.ci_upper);
        return {id,m,study:studies[id]};
    });
    const measure = points[0].m.label;
    if (!points.every(p => p.m.label === measure && p.study.design === points[0].study.design && p.study.population === points[0].study.population)) throw Error('図の比較条件が異なります');
    const low = Math.min(0.8,...points.map(p=>Number(p.m.ci_lower))) / 1.12;
    const high = Math.max(1.25,...points.map(p=>Number(p.m.ci_upper))) * 1.12;
    const x = n => 8 + Math.log(n/low)/Math.log(high/low)*217;
    const offset = rows.length>1?100:6;
    const yEnd = 15 + (rows.length-1)*29;
    let svg = '<svg class="plot" viewBox="0 0 '+(offset+240)+' '+(yEnd+31)+'" aria-label="'+measure+' 研究別効果推定値と95%信頼区間"><g transform="translate('+offset+' 0)">';
    svg += '<path d="M'+x(1)+' 1V'+(yEnd+8)+'" stroke="#8c9691" stroke-dasharray="3 3"/>';
    for (const [i,{id,m,study}] of points.entries()) {
        const y = 12+i*29, a=x(+m.ci_lower), b=x(+m.ci_upper), c=x(+m.estimate);
        const label = ({e16:'気管支炎様症状',e17:'息切れ',e66:'喘鳴',e18:'電子たばこ単独',e70:'紙巻きと併用',e71:'紙巻き単独'})[id] || study.outcome;
        svg += '<g class="plot-row" tabindex="0" role="button" data-point="'+id+'" aria-label="'+esc(label+' '+m.label+' '+m.estimate+'、研究の詳細')+'"><title>'+esc(study.reference+' '+label+' '+m.reported)+'</title><rect x="'+(-offset)+'" y="'+(y-12)+'" height="25" width="'+(offset+235)+'" fill="transparent"/>'+
               (rows.length>1?'<text x="'+(-offset+2)+'" y="'+(y+4)+'" font-size="11.8">'+label+'</text>':'')+
               '<path d="M'+a+' '+(y-4)+'v8m0-4H'+b+'m0-4v8" stroke="#2b665c" stroke-width="2.3" fill="none"/>'+
               circle(c,y,8,'#70b3a0','class="halo" opacity="'+(id===selected?'.33':'0')+'"')+circle(c,y,4.5,'#155e54')+'</g>';
    }
    const ticks = high/low < 3.4 ? [0.5,0.75,1,1.25,1.5,2,2.5,3] : [0.5,1,2,4,8,12];
    for (const tick of ticks.filter(t=>t>low && t<high)) {
        svg += '<text x="'+x(tick)+'" y="'+(yEnd+24)+'" text-anchor="middle" font-size="10">'+tick+'</text>';
    }
    return svg+'</g></svg>';
}
function render(focusTarget) {
    document.body.dataset.stage=stage;
    const group=ids();
    $('stages').innerHTML=labels.map((label,i)=>'<button type="button" aria-pressed="'+(stage===i)+'" class="stage" data-stage-choice="'+i+'"><svg viewBox="0 0 105 126" aria-hidden="true">'+circle(54,67,50,['#e4cfdc','#f6d69c','#e0cf92','#cbd9df'][i])+use(icons[i],3,4,.98)+'</svg><span><b>'+label+'</b><small>'+topics[i]+'</small></span></button>').join('');
    $('stageLabel').textContent=labels[stage]+'　／　'+topics[stage];
    $('sceneTitle').textContent=sceneTitles[stage][variant()];
    $('artCaption').textContent=stage===0?'実験所見を順に見る · '+(step+1)+' / 4':'ライフステージ　'+(stage+1)+' / 4';
    $('prev').disabled=stage===0;
    $('next').disabled=stage===3;
    illustration();
    const choices=stage===0?titles:options[stage];
    const nextTopic = choices[(variant()+1) % choices.length];
    $('artAction').textContent = nextTopic+'の図へ →';
    $('artExplore').setAttribute('aria-label',nextTopic+'の図に切り替える');
    $('switches').innerHTML=choices.map((v,i)=>'<button type="button" data-option="'+i+'" aria-pressed="'+(i===variant())+'">'+esc(v)+'</button>').join('');
    const e=facts.get(selected), s=studies[selected];
    $('studyline').textContent=s?s.reference+'　·　'+s.design:'レビュー著者の記述　·　胎内曝露';
    $('message').textContent=messages[stage][variant()];
    if(selected==='e70') $('message').textContent='併用群の新規診断の推定値も、信頼区間は1を含んだ。';
    if(selected==='e71') $('message').textContent='紙巻き単独使用は、喘息新規診断と関連した。';
    $('population').textContent=s?s.population+'。'+s.exposure+'。':'妊娠期の実験的曝露を扱った動物研究と、ヒトでの研究の空白を区別して読む。';
    let body='';
    const m=e.measurements.find(v=>v.estimate && v.ci_lower && v.ci_upper);
    if(m) {
        body='<div class="result"><p class="outcome">'+esc(s.outcome)+'</p><span class="metric">'+esc(m.label)+'</span><strong class="number">'+esc(m.estimate)+'</strong><span class="ci">95% CI　'+esc(m.ci_lower)+'–'+esc(m.ci_upper)+'</span>'+plot(group)+'<p class="micro">対数目盛　·　破線は比＝1　·　横線は95% CI</p></div>';
    } else if(stage===0) {
        const note=['肺胞、気道、遺伝子発現の3つの候補を、それぞれの実験条件で見る。','ニコチン群の生後4日の肺組織を対照と比較。','ダニ誘発モデルで、肺胞洗浄液中の好中球が増加。','ニコチン群と基剤群では、変化した遺伝子群が異なる。'][step];
        body='<div class="result"><p class="outcome">図1の候補機序　／　表1の実験所見</p><p class="state-note">'+note+'</p></div><div class="steps">'+(step?button('← 戻る','step',step-1,'ref'):'')+button(step===3?'最初に戻る ↺':'次の図へ →','step',step===3?0:step+1,'step')+'</div>';
    } else if(stage===1) {
        body='<div class="result"><p class="outcome">症状日数の群間比較</p><strong class="number">'+esc(e.measurements[0].reported)+'</strong><p class="micro">二変量解析 · 効果量はこの所見に未収録</p></div>';
    } else {
        const outcomes = [['FEV1/FVC','↓','e20'],['PEF','↓','e20'],['FeNO','↑','e98']];
        const arrows = outcomes.map(([label,arrow,id]) =>
            '<button class="vital" data-action="inspect" data-value="'+id+'" aria-label="'+label+(arrow==='↑'?'上昇':'低下')+'の詳細"><span>'+arrow+'</span>'+label+'</button>'
        ).join('');
        body='<div class="result"><p class="outcome">吸入前 → 15分後　／　喘息群</p><div class="acute">'+arrows+'</div><p class="micro">矢印は変化の方向。健常喫煙者ではFeNOは低下。</p></div>';
    }
    $('results').innerHTML=body;
    const pages=[...new Set(e.source_refs.map(id=>refs.get(id).pdf_page_start))].sort((a,b)=>a-b);
    $('actions').innerHTML=button('研究の詳細 ↗','inspect',selected,'pill')+button('原文 p.'+pages.join('・'),'source',selected);
    if(focusTarget) document.querySelector(focusTarget)?.focus({preventScroll:true});
}
function setStage(i, focus=false) {
    stage=i; topic=0;step=0;selected=ids()[0];
    render(focus?'[data-stage-choice="'+i+'"]':null);
}
function setOption(i, focus=true) {
    if(stage===0) step=i; else topic=i;
    selected=stage===0?ids()[step]:ids()[0];
    render(focus?'[data-option="'+i+'"]':null);
}
$('stages').onclick=event=>{const b=event.target.closest('[data-stage-choice]');if(b)setStage(+b.dataset.stageChoice,true)};
$('switches').onclick=event=>{const b=event.target.closest('[data-option]');if(b)setOption(+b.dataset.option)};
$('artExplore').onclick=()=>{
    setOption((variant()+1) % sceneTitles[stage].length,false);
};
$('prev').onclick=()=>setStage(stage-1,true);
$('next').onclick=()=>setStage(stage+1,true);

function ensurePdf() {
    if(!pdfUrl) {
        const bytes=Uint8Array.from(atob($('pdf').content.textContent.trim()),c=>c.charCodeAt(0));
        pdfUrl=URL.createObjectURL(new Blob([bytes],{type:'application/pdf'}));
    }
    return pdfUrl;
}
function blocks(value) {
    if(Array.isArray(value))return value.map(blocks).join('');
    if(value && typeof value==='object')return Object.entries(value).map(([k,v])=>'<p><b>'+esc(k)+'</b></p>'+blocks(v)).join('');
    return value?'<p>'+esc(value)+'</p>':'';
}
function showDialog(title,html) {
    if(!$('drawer').open) {
        returnFocus=document.activeElement;
        $('drawer').showModal();
        $('close').focus({preventScroll:true});
    }
    $('drawerTitle').textContent=title;
    $('drawerBody').innerHTML=html;
    $('drawer').scrollTop=0;
}
function sourceCard(id) {
    const r=refs.get(id);
    const range=r.pdf_page_end && r.pdf_page_end!==r.pdf_page_start?'–'+r.pdf_page_end:'';
    return '<section><h3>'+esc([r.citation,r.table,r.figure].filter(Boolean).join(' · ')||'原本の記述')+'</h3><a target="_blank" rel="noopener" href="'+ensurePdf()+'#page='+r.pdf_page_start+'">PDF p.'+r.pdf_page_start+range+' を開く ↗</a><blockquote>'+esc(r.quote)+'</blockquote><small>'+esc(id)+'</small></section>';
}
function inspect(id,sourceOnly=false) {
    const e=facts.get(id),s=studies[id]||{};
    const details=[['研究デザイン',s.design],['対象',s.population||e.population],['曝露・比較',s.exposure],['対照',s.comparator],['評価項目',s.outcome],['調整因子',s.adjustments],['適用条件',e.conditions],['限界・例外',e.exceptions]];
    let body=libraryActive?button('← 全研究・原文','back-library',''):'';
    body+='<p class="study-line">'+esc(id+'　·　'+(s.design||e.kind))+'</p>'+blocks(e.statement_ja);
    if(!sourceOnly) body+='<dl>'+details.filter(([,v])=>v && v.length).map(([k,v])=>'<dt>'+k+'</dt><dd>'+blocks(v)+'</dd>').join('')+'</dl>'+e.measurements.map(v=>'<p><b>'+esc(v.label)+'</b>　'+esc(v.reported)+'</p>').join('');
    body+='<h3>原文の該当箇所</h3>'+e.source_refs.map(sourceCard).join('');
    showDialog(sourceOnly?'原文とページ':s.reference||'医学的な記述',body);
}
const fieldLabels={topic:'テーマ',clinical_area:'臨床領域',one_line_summary:'Take Home Message',why_important:'医学的背景',study_design:'研究方法',population_setting:'研究対象',figure_table_summary:'図表の要点',main_results:'主要結果',pico:'PICO',safety:'安全性',limitations:'限界',applicability_to_japanese_pediatric_clinic:'日本の小児科外来への適用',practice_change:'Practice Change',practice_change_reason:'判断の理由',tomorrow_action:'外来への示唆',summary_jp:'日本語要約'};
const statusNames={recorded:'記載済み',not_reported:'原文に記載なし',not_assessed:'未評価',not_applicable:'該当なし',not_acquired:'未取得'};
const linksToFacts=ids=>ids.map(id=>button(id,'inspect',id)).join(' ');
function overview() {
    return Object.entries(fieldLabels).map(([k,label])=>{
        const record=master.teaching.fields[k],v=master.overview[k];
        return '<h3>'+esc(label)+(record?.origin==='ai_interpretation'?' · AIによる臨床的解釈':'')+'</h3>'+
            (k==='main_results'?v.map((s,i)=>blocks(s)+linksToFacts(master.overview.result_evidence_ids[i])).join(''):
            (blocks(v)||blocks([statusNames[record?.status],record?.reason])))+(record?linksToFacts(record.evidence_ids):'');
    }).join('')+'<h3>臨床的解釈 · AI</h3>'+master.clinical_interpretation.map(b=>blocks(b.text_ja)+linksToFacts(b.evidence_ids)).join('');
}
let libraryActive=false,libTab=0,query='';
const tabLabels=['研究・所見','章別精読','抄録・要点','出典・品質'];
function filteredEvidence() {
    const search=query.normalize('NFKC').toLowerCase().trim();
    const list=master.evidence.filter(e=>[e.id,e.statement_ja,...Object.values(studies[e.id]||{}),...(e.exceptions||[]),...e.measurements.map(v=>v.reported)].join(' ').normalize('NFKC').toLowerCase().includes(search));
    $('libraryList').innerHTML='<p class="micro">'+list.length+' / '+master.evidence.length+' 所見</p>'+list.map(e=>'<article><h3>'+esc(studies[e.id]?.reference||e.id)+'</h3>'+blocks(e.statement_ja)+button('詳細・原文','inspect',e.id)+'</article>').join('');
}
function library(tab=libTab) {
    libraryActive=true;libTab=tab;
    let html='<div class="keys">'+tabLabels.map((v,i)=>'<button data-lib="'+i+'" aria-pressed="'+(i===tab)+'">'+v+'</button>').join('')+'</div>';
    if(tab===0)html+='<label>研究名・アウトカム・根拠IDで検索<input type="search" id="filter" value="'+esc(query)+'"></label><div id="libraryList"></div>';
    if(tab===1)html+=master.chapters.map(c=>'<details><summary>'+esc(c.title_ja)+'</summary>'+blocks(c.summary_ja)+c.blocks.map(b=>blocks(b.text_ja)+linksToFacts(b.evidence_ids)).join('')+'<details><summary>章の原文参照</summary>'+c.source_refs.map(sourceCard).join('')+'</details></details>').join('');
    if(tab===2)html+=overview()+'<h3>抄録・対訳</h3>'+master.abstract.parts.map((part,i)=>blocks(part.original)+blocks(part.translation_ja)+'<a target="_blank" rel="noopener" href="'+ensurePdf()+'#page='+master.teaching.abstract_pages[i]+'">原文抄録 ↗</a>').join('');
    if(tab===3)html+='<h3>品質評価</h3>'+Object.entries(master.teaching.quality).map(([k,v])=>'<details><summary>'+esc(k)+' · '+esc(v.status)+'</summary>'+blocks(v.note)+blocks(v.reviewer)+'</details>').join('')+'<h3>生成・確認記録</h3>'+blocks(master.generation_metadata)+blocks(master.quality_control.issues.map(i=>i.note))+blocks('原本PDF SHA-256　'+master.metadata.pdf_sha256)+'<details><summary>全出典 '+master.source_references.length+'件</summary>'+master.source_references.map(s=>sourceCard(s.id)).join('')+'</details>';
    showDialog('全研究・原文',html);
    if(tab===0){filteredEvidence();$('filter').oninput=e=>{query=e.target.value;filteredEvidence()};}
}
$('library').onclick=()=>library();
$('overview').onclick=()=>library(2);
$('close').onclick=()=>$('drawer').close();
$('drawer').onclose=()=>{libraryActive=false;if(returnFocus?.isConnected)returnFocus.focus({preventScroll:true});};
document.addEventListener('click',event=>{
    const b=event.target.closest('[data-point],[data-action],[data-lib]');
    if(!b)return;
    if(b.dataset.lib!==undefined){library(+b.dataset.lib);document.querySelector('[data-lib="'+libTab+'"]').focus();return;}
    if(b.dataset.point){selected=b.dataset.point;render('[data-point="'+selected+'"]');inspect(selected);return;}
    const {action,value}=b.dataset;
    if(action==='step')setOption(+value);
    if(action==='inspect'||action==='source')inspect(value,action==='source');
    if(action==='back-library')library();
});
document.addEventListener('keydown',event=>{
    if($('drawer').open||event.ctrlKey||event.metaKey||event.altKey)return;
    if(event.target.closest('[data-point]') && [' ','Enter'].includes(event.key)){
        event.preventDefault();event.target.closest('[data-point]').dispatchEvent(new MouseEvent('click',{bubbles:true}));return;
    }
    if(['ArrowLeft','ArrowRight'].includes(event.key)){
        event.preventDefault();setStage(Math.max(0,Math.min(3,stage+(event.key==='ArrowRight'?1:-1))),true);
    }
});
render();
</script></body></html>

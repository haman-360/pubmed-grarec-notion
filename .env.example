# 継続台帳・二段階Batch（予算は起動メニュー5で設定）
OPENAI_API_KEY=
# モデル・料金は scripts/paper_pipeline/batches.py で版管理する。
# APIクレジットの残額・有効期限は請求画面で確認する。

# Notion: Integrationに対象DBを接続する
NOTION_TOKEN=
NOTION_DATABASE_ID=
# 複数data sourceの場合だけ指定する
NOTION_DATA_SOURCE_ID=
NOTION_FILE_UPLOAD_VERSION=2026-03-11

# PDF探索（Unpaywallのメール指定は必須）
UNPAYWALL_EMAIL=
NCBI_EMAIL=
NCBI_API_KEY=

# 空欄ならリポジトリ直下 .paper_pipeline を使用
# 独自パスはリポジトリ外のローカルフォルダを指定
# PAPER_PIPELINE_HOME=/Users/yourname/Library/Application Support/PaperPipeline

# 以下は旧手動機能用。新自動フローでは使わない。
OPENAI_MODEL=gpt-5.6-terra
OPENAI_PROCESSING_MODE=batch
OPENAI_PDF_DETAIL=low
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_COST_PER_PAPER_USD=0.50
OPENAI_MAX_BATCH_PAPERS=5
OPENAI_BATCH_INPUT_USD_PER_MILLION=1.00
OPENAI_BATCH_OUTPUT_USD_PER_MILLION=6.00
GITHUB_PAGES_BASE_URL=https://haman-360.github.io/pubmed-grarec-notion

# OpenAI Batch API (ChatGPT subscriptionとは別料金)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_PROCESSING_MODE=batch
OPENAI_PDF_DETAIL=low
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_COST_PER_PAPER_USD=0.50
OPENAI_MAX_BATCH_PAPERS=5

# 2026-08-01時点のgpt-5.6-terra Batch料金。料金改定時に更新してください。
OPENAI_BATCH_INPUT_USD_PER_MILLION=1.00
OPENAI_BATCH_OUTPUT_USD_PER_MILLION=6.00

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_FILE_UPLOAD_VERSION=2026-03-11

# NCBI（推奨）
NCBI_EMAIL=
NCBI_API_KEY=

# 旧GitHub Pages運用を使う場合のみ
GITHUB_PAGES_BASE_URL=https://haman-360.github.io/pubmed-grarec-notion
